# Copy this file to .env and replace placeholders with your local values.
# Never commit or share the real .env file.

# Required only when using Gemini-powered chat.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional application settings (defaults are shown).
GEMINI_MODEL=gemini-3.5-flash-lite
ASSISTANT_NAME=MBRUS
HOST=127.0.0.1
PORT=8000
DEFAULT_CITY=New Delhi
TTS_VOICE=en-US-ChristopherNeural
TTS_RATE=+18%
TTS_PITCH=+0Hz
